{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build and test (mvn verify)",
			"type": "shell",
			"command": "./mvnw",
			"args": [
				"-B",
				"verify"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Install framework to local Maven repository",
			"type": "shell",
			"command": "./mvnw",
			"args": [
				"-B",
				"install",
				"-pl",
				"framework"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		}
	]
}
