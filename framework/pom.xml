<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.valentinherrmann</groupId>
    <artifactId>levenshtein-testing-framework</artifactId>
    <version>2026.11.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Levenshtein Testing Framework</name>
    <description>Structural and behavioural tests for student code that tolerate small naming deviations (Levenshtein distance), built on Ares 2</description>
    <url>https://github.com/ValentinHerrmann/Levenshtein-Testing-Framework</url>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <ares.version>2.2.1</ares.version>
        <!-- Versions match the ones Ares 2.2.1 brings, so consumers get one consistent set. -->
        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <byte-buddy.version>1.18.14</byte-buddy.version>
    </properties>

    <dependencies>
        <!--
          All runtime dependencies are "provided": every consumer is an Ares 2 exercise and
          already declares de.tum.cit.ase:ares (as provided, so that AspectJ can weave), which
          brings JUnit, AssertJ and Byte Buddy. Declaring them here keeps the framework compiling
          against exactly what it uses instead of relying on Ares' transitive graph.
        -->
        <dependency>
            <groupId>de.tum.cit.ase</groupId>
            <artifactId>ares</artifactId>
            <version>${ares.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- ReflectionSupport (finding the member wrapper fields) -->
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-commons</artifactId>
            <version>${junit.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- Byte Buddy >= 1.17.7 is needed to read Java 25 class files. -->
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>${byte-buddy.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>enforce-toolchain</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <excludes>
                        <exclude>**/RealOutOfMemoryTest.java</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- Student code that really runs out of heap (#44): in its own JVM with a small heap. -->
                    <execution>
                        <id>out-of-memory</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/RealOutOfMemoryTest.java</include>
                            </includes>
                            <argLine>-Xmx64m</argLine>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Mutation testing of the framework itself (PIT). Activate with -P mutation:
            ./mvnw -f framework/pom.xml -P mutation verify
          The report lands in target/pit-reports/index.html; the build fails below mutationThreshold.
          Only framework classes are mutated, never the test fixtures or the example exercises.
        -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.30.2</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.3</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>mutation-coverage</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <targetClasses>
                                <param>io.github.valentinherrmann.levenshtein.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>io.github.valentinherrmann.levenshtein.*</param>
                            </targetTests>
                            <excludedClasses>
                                <param>io.github.valentinherrmann.levenshtein.fixtures.*</param>
                            </excludedClasses>
                            <!-- needs the small heap of its own surefire execution; the other tests cover the code -->
                            <excludedTestClasses>
                                <param>io.github.valentinherrmann.levenshtein.RealOutOfMemoryTest</param>
                            </excludedTestClasses>
                            <mutators>
                                <mutator>STRONGER</mutator>
                            </mutators>
                            <threads>2</threads>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats>
                                <format>HTML</format>
                                <format>XML</format>
                            </outputFormats>
                            <!--
                              Gate: about 3 points below the measured score (93 % mutants killed, 97 % lines
                              covered), so a change that adds untested code fails CI. Raise it as the score
                              rises; the remaining survivors are mostly equivalent mutants (see the PR of #23).
                            -->
                            <mutationThreshold>90</mutationThreshold>
                            <coverageThreshold>95</coverageThreshold>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Everything needed for Maven Central only. Activate with -P release. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <doclint>none</doclint>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.9.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- The credentials are a Central Portal user token (as for 1000.0.0). -->
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <scm>
        <url>https://github.com/ValentinHerrmann/Levenshtein-Testing-Framework</url>
        <connection>scm:git:git://github.com/ValentinHerrmann/Levenshtein-Testing-Framework.git</connection>
        <developerConnection>scm:git:git@github.com:ValentinHerrmann/Levenshtein-Testing-Framework.git</developerConnection>
        <tag>HEAD</tag>
    </scm>
