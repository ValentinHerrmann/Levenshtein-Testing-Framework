@startuml
skinparam classAttributeIconSize 0
hide circle
skinparam linetype ortho

!include https://raw.githubusercontent.com/patrik-csak/one-dark-plantuml-theme/v1.0.1/theme.puml

package "io.github.valentinherrmann (framework: .levenshtein, example tests: .example.tests)" as AET {

    package "levenshtein" <<Framework>> {
        abstract class Wrapper<T> {
            #name: WrapperProperty<String>
            #modifiers: WrapperProperty<String>
            #existence: Existence
        }

        abstract class ClassWrapper<T> {
            +getClazz(): Class<T>
            +getObj(forceNew, useByteBuddy): Object
            +getAttributeWrappers(): List<Wrapper<T>>
            +getMethodsWrappers(): List<Wrapper<T>>
            +getConstructorWrappers(): List<Wrapper<T>>
        }

        class GenericClassWrapper<T> {
            +GenericClassWrapper(clz: Class<T>)
        }

        class AttributeWrapper<T,V> {
            +getValue(): V
            +setValue(value: V)
        }

        class MethodWrapper<T,R> {
            +invoke(params...): R
        }

        class ConstructorWrapper<T> {
            +invoke(args...): T
        }

        ClassWrapper --|> Wrapper
        GenericClassWrapper --|> ClassWrapper
        AttributeWrapper --|> Wrapper
        MethodWrapper --|> Wrapper
        ConstructorWrapper --|> Wrapper
    }

    package "wrappers" <<Test Implementation>> {

        class DrivableWrapper<T> {
            -maxSpeed: AttributeWrapper
            -startMethod: MethodWrapper
            -getSpeedMethod: MethodWrapper
            --
            +DrivableWrapper()
            +maxSpeed(): AttributeWrapper
            +startMethod(): MethodWrapper
            +getSpeedMethod(): MethodWrapper
        }
        note right of DrivableWrapper
            Wraps the **Driveable** interface
            • MAX_SPEED constant
            • start() method
            • getSpeed() method
        end note

        class AbstrWrapper<T> {
            -manufacturer: AttributeWrapper
            -year: AttributeWrapper
            -constructor: ConstructorWrapper
            -getManufacturer: MethodWrapper
            -getYear: MethodWrapper
            -calculateCost: MethodWrapper
            -getInfo: MethodWrapper
            --
            +AbstrWrapper()
            +manufacturer(): AttributeWrapper
            +year(): AttributeWrapper
            +constructor(): ConstructorWrapper
            +getManufacturer(): MethodWrapper
            +getYear(): MethodWrapper
            +calculateCost(): MethodWrapper
            +getInfo(): MethodWrapper
        }
        note right of AbstrWrapper
            Wraps the **AbstractVehicle** abstract class
            • manufacturer, year attributes
            • abstract calculateCost() method
            • concrete getInfo() method
        end note

        class CarWrapper<T> {
            -price: AttributeWrapper
            -speed: AttributeWrapper
            -constructor_full: ConstructorWrapper
            -constructor_default: ConstructorWrapper
            -getPrice: MethodWrapper
            -start: MethodWrapper
            -getSpeed: MethodWrapper
            -calculateCost: MethodWrapper
            -calculateCostYears: MethodWrapper
            -getInfo: MethodWrapper
            --
            +CarWrapper(superClassWrapper, interfaceWrappers...)
            +price(): AttributeWrapper
            +speed(): AttributeWrapper
            +constructor_full(): ConstructorWrapper
            +constructor_default(): ConstructorWrapper
            +calculateCost(): MethodWrapper
            +calculateCostYears(): MethodWrapper
        }
        note right of CarWrapper
            Wraps the **Car** concrete class
            • Extends AbstractVehicle
            • Implements Driveable
            • Demonstrates:
              - Constructor overloading
              - Method overloading
              - Method overriding
        end note

        DrivableWrapper --|> ClassWrapper
        AbstrWrapper --|> ClassWrapper
        CarWrapper --|> ClassWrapper

        ' Show relationships between wrappers
        CarWrapper ..> AbstrWrapper : superClassWrapper
        CarWrapper ..> DrivableWrapper : interfaceWrappers
    }
}

legend bottom
    **Pattern Overview:**
    • **levenshtein** package: Framework classes for fuzzy structural testing
    • **wrappers** package: Concrete test implementations for specific classes
    • Each wrapper verifies existence, names, types, and modifiers with Levenshtein distance tolerance
end legend

@enduml

